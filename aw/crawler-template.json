{
  "version": "1.0",
  "contract": "bonsai/idol-research/schema/discovery.py",
  "engine": "both",
  "user_agent": "bonsai/idol-db-crawler/1.0",
  "max_queries": 500,
  "timeout_seconds": 20,
  "dedupe_key": "url",
  "intents": [
    {"id":"event_discovery","family":"event","purpose":"find live events","template":"%s アイドル ライブ イベント","terms":["東京","関東","大阪","名古屋","全国"],"limit":12},
    {"id":"date_discovery","family":"event","purpose":"find event dates","template":"%s アイドル ライブ 2026","terms":["今日","今週","今月","10月","11月","12月"],"limit":12},
    {"id":"venue_discovery","family":"event","purpose":"find venues","template":"%s アイドル ライブハウス","terms":["新宿","渋谷","池袋","秋葉原","横浜","川崎"],"limit":10},
    {"id":"ticket_discovery","family":"event","purpose":"find ticket information","template":"%s アイドル チケット","terms":["前売","当日券","予約","販売","受付"],"limit":10},
    {"id":"performer_discovery","family":"event","purpose":"find performers","template":"%s アイドル 出演","terms":["ライブ","イベント","フェス","対バン","ワンマン"],"limit":10},
    {"id":"official_discovery","family":"event","purpose":"find official schedules","template":"%s アイドル 公式","terms":["ライブ情報","イベント情報","スケジュール","出演情報"],"limit":10},
    {"id":"agency_discovery","family":"event","purpose":"find agencies and operators","template":"%s アイドル 運営 イベント","terms":["事務所","運営","主催","制作"],"limit":10},
    {"id":"genre_discovery","family":"event","purpose":"discover scene categories","template":"%s アイドル ライブ","terms":["地下アイドル","女性アイドル","ローカルアイドル","ご当地アイドル","アイドルフェス"],"limit":10},
    {"id":"edge_discovery","family":"event","purpose":"find lifecycle events","template":"%s アイドル","terms":["リリースイベント","生誕祭","周年","卒業","新体制","お披露目"],"limit":10},
    {"id":"song_discovery","family":"music","purpose":"find songs and releases","template":"%s アイドル 曲","terms":["新曲","新曲リリース","楽曲","MV","Music Video","歌詞","配信","サブスク"],"limit":12},
    {"id":"song_performer_discovery","family":"music","purpose":"connect songs to performers","template":"%s アイドル 楽曲","terms":["おすすめ","人気曲","代表曲","ライブ定番曲","最新曲"],"limit":10},
    {"id":"music_platform_discovery","family":"music","purpose":"find music distribution signals","template":"%s アイドル 音楽","terms":["YouTube","Spotify","Apple Music","TikTok","配信"],"limit":10},
    {"id":"ego_search","family":"fan","purpose":"monitor public mentions","template":"%s アイドル","terms":["評判","感想","口コミ","好き","推し","おすすめ","話題","バズ","炎上"],"limit":12},
    {"id":"fan_voice","family":"fan","purpose":"capture public fan voice","template":"%s アイドル ファン","terms":["感想","現場","ライブレポ","物販","特典会","遠征","推し活"],"limit":10},
    {"id":"social_listening","family":"fan","purpose":"observe public social signals","template":"%s アイドル SNS","terms":["X","Instagram","TikTok","YouTube","投稿","反応"],"limit":10},
    {"id":"business_need","family":"business","purpose":"find demand and sponsor signals","template":"%s アイドル","terms":["案件","スポンサー","広告","コラボ","タイアップ","企業","ブランド"],"limit":10},
    {"id":"business_supply","family":"business","purpose":"find casting opportunities","template":"%s アイドル","terms":["出演依頼","キャスティング","イベント出演","広告出演","コラボ募集"],"limit":10},
    {"id":"merchandise","family":"business","purpose":"observe commerce signals","template":"%s アイドル","terms":["グッズ","物販","写真","チェキ","限定","通販"],"limit":10},
    {"id":"collaboration","family":"business","purpose":"find partner industries","template":"%s アイドル コラボ","terms":["飲食店","アパレル","美容","ゲーム","アニメ","地域","観光"],"limit":10},
    {"id":"growth_signal","family":"growth","purpose":"detect growth and launch signals","template":"%s アイドル","terms":["新メンバー","オーディション","デビュー","新体制","活動開始"],"limit":10},
    {"id":"risk_signal","family":"risk","purpose":"detect activity risk signals","template":"%s アイドル","terms":["休止","解散","卒業","脱退","中止","延期"],"limit":10}
  ]
}